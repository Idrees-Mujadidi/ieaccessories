# Public Supabase project URL and publishable key used by the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Server-side equivalents used during SSR.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Optional. Keep this secret and server-only; never add a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
